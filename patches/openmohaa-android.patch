diff --git a/cmake/platforms/android.cmake b/cmake/platforms/android.cmake
new file mode 100644
index 0000000..6c2c9ef
--- /dev/null
+++ b/cmake/platforms/android.cmake
@@ -0,0 +1,40 @@
+# Android specific settings
+#
+# The Android build is driven by android/build_native.sh which builds the
+# dependencies (SDL2, OpenAL Soft, gl4es) first and passes their locations:
+#   SDL2_DIR           - SDL2 CMake config directory
+#   OPENAL_INCLUDE_DIR - OpenAL Soft include directory (containing AL/)
+#   OPENAL_LIBRARY     - libopenal.so
+#   GL4ES_INCLUDE_DIR  - gl4es include directory
+#   GL4ES_LIBRARY      - libGL.a (static gl4es)
+
+if(NOT ANDROID)
+    return()
+endif()
+
+# Android only packages native libraries named lib*.so
+set(CMAKE_SHARED_LIBRARY_PREFIX "lib")
+
+# Disable options that don't make sense on Android
+set(BUILD_SERVER OFF CACHE INTERNAL "")
+set(BUILD_GAME_QVMS OFF CACHE INTERNAL "")
+set(USE_HTTP OFF CACHE INTERNAL "")
+set(USE_OPENAL_DLOPEN OFF CACHE INTERNAL "")
+set(USE_INTERNAL_SDL OFF CACHE INTERNAL "")
+
+# Both renderers are built as loadable modules:
+#  - opengl1: the classic renderer, running on OpenGL ES 2 through gl4es (default)
+#  - opengl2: native OpenGL ES renderer (experimental)
+set(BUILD_RENDERER_GL1 ON CACHE INTERNAL "")
+set(BUILD_RENDERER_GL2 ON CACHE INTERNAL "")
+set(USE_RENDERER_DLOPEN ON CACHE INTERNAL "")
+
+# The engine was written for x86 where plain "char" is signed; on ARM it is
+# unsigned by default, which subtly breaks code that relies on negative chars
+add_compile_options(-fsigned-char)
+
+# No LTO, it makes debugging crashes from logcat much harder
+set(CMAKE_INTERPROCEDURAL_OPTIMIZATION FALSE)
+
+list(APPEND CLIENT_LIBRARIES log android)
+list(APPEND COMMON_LIBRARIES log)
