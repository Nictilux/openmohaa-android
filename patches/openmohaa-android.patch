new file mode 100644
index 0000000..c37535c
--- /dev/null
+++ b/code/sdl/sdl_touch.c
@@ -0,0 +1,711 @@
+/*
+===========================================================================
+Touch screen controls for OpenMoHAA (Android port)
+
+This file is part of OpenMoHAA source code.
+
+OpenMoHAA source code is free software; you can redistribute it
+and/or modify it under the terms of the GNU General Public License as
+published by the Free Software Foundation; either version 2 of the License,
+or (at your option) any later version.
+===========================================================================
+
+Virtual on-screen controls drawn on top of the game:
+  - left half of the screen: floating movement stick
+  - right half of the screen: swipe to look around
+  - buttons: fire, alt fire, jump, crouch (toggle), reload, use,
+    lean left/right, next/prev weapon, scores, menu (escape),
+    keyboard toggle, console
+
+Controls are only active while actually playing (no menu / console open).
+While a menu is open, SDL's synthesized mouse events are used as a cursor.
+*/
+
+#ifdef USE_INTERNAL_SDL_HEADERS
+#	include "SDL.h"
+#else
+#	include <SDL.h>
+#endif
+
+#include <math.h>
+
+#include "../client/client.h"
+
+#define TOUCH_MAX_FINGERS 10
+
+typedef enum {
+	TB_COMMAND,     // "+cmd" on press, "-cmd" on release
+	TB_ONESHOT,     // command executed once on press
+	TB_TOGGLE,      // "+cmd" / "-cmd" alternating on every press
+	TB_KEY,         // send a key event
+	TB_KEYBOARD,    // toggle the on-screen keyboard
+} touchButtonType_t;
+
+typedef enum {
+	TV_GAME = 1,    // visible while playing
+	TV_MENU = 2,    // visible while a menu/console is open
+} touchVisibility_t;
+
+typedef struct {
+	const char        *label;
+	const char        *labelRu;  // Windows-1251, used with the Russian version of the game
+	touchButtonType_t type;
+	const char        *cmd;
+	int               key;
+	float             x, y;     // center, x in screen widths, y in screen heights
+	float             r;        // radius in screen heights
+	int               vis;
+	qboolean          lookWhileHeld; // finger may drag to look while held (fire)
+
+	// runtime state
+	qboolean          down;
+	qboolean          toggled;
+} touchButton_t;
+
+static touchButton_t touchButtons[] = {
+	// label    labelRu       type          cmd                 key         x      y      r      visibility       look
+	{ "FIRE", "\xCE\xC3\xCE\xCD\xDC",   TB_COMMAND,   "attackprimary",    0,          0.82f, 0.66f, 0.11f, TV_GAME,         qtrue  },
+	{ "ALT", "\xD3\xC4\xC0\xD0",    TB_COMMAND,   "attacksecondary",  0,          0.94f, 0.48f, 0.065f, TV_GAME,        qtrue  },
+	{ "JUMP", "\xCF\xD0\xDB\xC6\xCE\xCA",   TB_COMMAND,   "moveup",           0,          0.94f, 0.82f, 0.075f, TV_GAME,        qfalse },
+	{ "CROUCH", "\xD1\xC5\xD1\xD2\xDC", TB_TOGGLE,    "movedown",         0,          0.68f, 0.86f, 0.065f, TV_GAME,        qfalse },
+	{ "RELOAD", "\xCF\xC5\xD0\xC5\xC7.", TB_ONESHOT,   "reload",           0,          0.66f, 0.62f, 0.06f, TV_GAME,         qfalse },
+	{ "USE", "\xC8\xD1\xCF.",    TB_COMMAND,   "use",              0,          0.80f, 0.40f, 0.06f, TV_GAME,         qfalse },
+	{ "<LEAN", "<\xC2\xDB\xC3\xCB",  TB_COMMAND,   "leanleft",         0,          0.60f, 0.12f, 0.055f, TV_GAME,        qfalse },
+	{ "LEAN>", "\xC2\xDB\xC3\xCB>",  TB_COMMAND,   "leanright",        0,          0.70f, 0.12f, 0.055f, TV_GAME,        qfalse },
+	{ "WPN-", "<\xCE\xD0\xD3\xC6",   TB_ONESHOT,   "weapprev",         0,          0.82f, 0.12f, 0.055f, TV_GAME,        qfalse },
+	{ "WPN+", "\xCE\xD0\xD3\xC6>",   TB_ONESHOT,   "weapnext",         0,          0.93f, 0.12f, 0.055f, TV_GAME,        qfalse },
+	{ "MENU", "\xCC\xC5\xCD\xDE",   TB_KEY,       NULL,               K_ESCAPE,   0.10f, 0.09f, 0.05f, TV_GAME,         qfalse },
+	{ "SCORE", "\xC7\xC0\xC4\xC0\xD7\xC8",  TB_COMMAND,   "scores",           0,          0.18f, 0.09f, 0.05f, TV_GAME,         qfalse },
+	{ "KBD", "\xCA\xCB\xC0\xC2.",    TB_KEYBOARD,  NULL,               0,          0.26f, 0.09f, 0.05f, TV_GAME|TV_MENU, qfalse },
+	{ "~", "\xCA\xCE\xCD\xD1.",      TB_KEY,       NULL,               K_CONSOLE,  0.33f, 0.09f, 0.04f, TV_GAME,         qfalse },
+};
+
+#define NUM_TOUCH_BUTTONS ( sizeof( touchButtons ) / sizeof( touchButtons[0] ) )
+
+typedef enum {
+	FR_NONE,
+	FR_STICK,
+	FR_LOOK,
+	FR_BUTTON,
+} fingerRole_t;
+
+typedef struct {
+	qboolean     active;
+	SDL_FingerID id;
+	fingerRole_t role;
+	int          button;   // index into touchButtons when role == FR_BUTTON
+	float        lastX, lastY;
+} touchFinger_t;
+
+static touchFinger_t fingers[TOUCH_MAX_FINGERS];
+
+static cvar_t *in_touch;
+static cvar_t *in_touchSens;
+static cvar_t *in_touchSensY;
+static cvar_t *in_touchAlpha;
+static cvar_t *in_touchScale;
+static cvar_t *in_touchStickSize;
+static cvar_t *in_touchInvertY;
+static cvar_t *in_touchLang;
+
+// movement stick state
+static qboolean stickActive;
+static float    stickOriginX, stickOriginY; // normalized
+static float    stickX, stickY;             // -1..1
+
+// accumulated look deltas (normalized screen units) waiting for the next usercmd
+static float lookAccumX, lookAccumY;
+
+static qboolean     touchWasInGame;
+static fontheader_t *touchFont;
+static int          touchRussian = -1; // -1: not checked yet
+
+/*
+===============
+Helpers
+===============
+*/
+static float Touch_Aspect( void ) {
+	int w = cls.glconfig.vidWidth;
+	int h = cls.glconfig.vidHeight;
+
+	if ( w <= 0 || h <= 0 ) {
+		return 16.0f / 9.0f;
+	}
+	return (float)w / (float)h;
+}
+
+qboolean IN_Touch_Enabled( void ) {
+	return in_touch && in_touch->integer != 0;
+}
+
+static qboolean Touch_InGame( void ) {
+	if ( clc.state != CA_ACTIVE ) {
+		return qfalse;
+	}
+	if ( Key_GetCatcher() & ( KEYCATCH_UI | KEYCATCH_CONSOLE | KEYCATCH_MESSAGE ) ) {
+		return qfalse;
+	}
+	return qtrue;
+}
+
+static int Touch_CurrentVisibility( void ) {
+	return Touch_InGame() ? TV_GAME : TV_MENU;
+}
+
+static void Touch_SendButtonCommand( touchButton_t *b, qboolean down ) {
+	switch ( b->type ) {
+	case TB_COMMAND:
+		Cbuf_AddText( va( "%c%s\n", down ? '+' : '-', b->cmd ) );
+		break;
+	case TB_ONESHOT:
+		if ( down ) {
+			Cbuf_AddText( va( "%s\n", b->cmd ) );
+		}
+		break;
+	case TB_TOGGLE:
+		if ( down ) {
+			b->toggled = !b->toggled;
+			Cbuf_AddText( va( "%c%s\n", b->toggled ? '+' : '-', b->cmd ) );
+		}
+		break;
+	case TB_KEY:
+		Com_QueueEvent( Sys_Milliseconds(), SE_KEY, b->key, down, 0, NULL );
+		break;
+	case TB_KEYBOARD:
+		if ( down ) {
+			if ( SDL_IsTextInputActive() ) {
+				SDL_StopTextInput();
+			} else {
+				SDL_StartTextInput();
+			}
+		}
+		break;
+	}
+}
+
+/*
+===============
+Touch_ReleaseAll
+
+Releases every held control (used when a menu pops up, so that
+nothing stays stuck, e.g. the fire button)
+===============
+*/
+static void Touch_ReleaseAll( void ) {
+	int i;
+
+	for ( i = 0; i < (int)NUM_TOUCH_BUTTONS; i++ ) {
+		touchButton_t *b = &touchButtons[i];
+
+		if ( b->down ) {
+			b->down = qfalse;
+			if ( b->type == TB_COMMAND || b->type == TB_KEY ) {
+				Touch_SendButtonCommand( b, qfalse );
+			}
+		}
+	}
+
+	for ( i = 0; i < TOUCH_MAX_FINGERS; i++ ) {
+		fingers[i].active = qfalse;
+	}
+
+	stickActive = qfalse;
+	stickX = stickY = 0;
+	lookAccumX = lookAccumY = 0;
+}
+
+/*
+===============
+Touch_ResetToggles
+
+Crouch toggle is reset when the player leaves the game
+===============
+*/
+static void Touch_ResetToggles( void ) {
+	int i;
+
+	for ( i = 0; i < (int)NUM_TOUCH_BUTTONS; i++ ) {
+		touchButton_t *b = &touchButtons[i];
+
+		if ( b->type == TB_TOGGLE && b->toggled ) {
+			b->toggled = qfalse;
+			Cbuf_AddText( va( "-%s\n", b->cmd ) );
+		}
+	}
+}
+
+static int Touch_HitButton( float x, float y ) {
+	int   i;
+	int   vis = Touch_CurrentVisibility();
+	float aspect = Touch_Aspect();
+	float scale = in_touchScale->value;
+
+	for ( i = 0; i < (int)NUM_TOUCH_BUTTONS; i++ ) {
+		const touchButton_t *b = &touchButtons[i];
+		float dx, dy, r;
+
+		if ( !( b->vis & vis ) ) {
+			continue;
+		}
+
+		// compare in screen-height units, give a bit of extra slack for fat fingers
+		dx = ( x - b->x ) * aspect;
+		dy = y - b->y;
+		r = b->r * scale * 1.15f;
+
+		if ( dx * dx + dy * dy <= r * r ) {
+			return i;
+		}
+	}
+
+	return -1;
+}
+
+static touchFinger_t *Touch_FindFinger( SDL_FingerID id ) {
+	int i;
+
+	for ( i = 0; i < TOUCH_MAX_FINGERS; i++ ) {
+		if ( fingers[i].active && fingers[i].id == id ) {
+			return &fingers[i];
+		}
+	}
+	return NULL;
+}
+
+static touchFinger_t *Touch_AllocFinger( SDL_FingerID id ) {
+	int i;
+
+	for ( i = 0; i < TOUCH_MAX_FINGERS; i++ ) {
+		if ( !fingers[i].active ) {
+			Com_Memset( &fingers[i], 0, sizeof( fingers[i] ) );
+			fingers[i].active = qtrue;
+			fingers[i].id = id;
+			return &fingers[i];
+		}
+	}
+	return NULL;
+}
+
+static void Touch_UpdateStick( float x, float y ) {
+	float aspect = Touch_Aspect();
+	float radius = in_touchStickSize->value * in_touchScale->value;
+	float dx = ( x - stickOriginX ) * aspect;
+	float dy = y - stickOriginY;
+	float len = sqrtf( dx * dx + dy * dy );
+
+	if ( radius <= 0.01f ) {
+		radius = 0.01f;
+	}
+
+	if ( len > radius ) {
+		// drag the origin along, so the stick never gets "stuck" at the edge
+		float excess = len - radius;
+		stickOriginX += ( dx / len ) * excess / aspect;
+		stickOriginY += ( dy / len ) * excess;
+		dx = dx / len * radius;
+		dy = dy / len * radius;
+	}
+
+	stickX = dx / radius;
+	stickY = dy / radius;
+}
+
+/*
+===============
+IN_Touch_HandleEvent
+
+Returns qtrue if the event was consumed by the touch controls
+===============
+*/
+qboolean IN_Touch_HandleEvent( const void *event ) {
+	const SDL_Event *e = (const SDL_Event *)event;
+	touchFinger_t   *f;
+	float           x, y;
+
+	if ( !IN_Touch_Enabled() ) {
+		return qfalse;
+	}
+
+	switch ( e->type ) {
+	case SDL_FINGERDOWN:
+		x = e->tfinger.x;
+		y = e->tfinger.y;
+
+		{
+			int btn = Touch_HitButton( x, y );
+
+			if ( !Touch_InGame() ) {
+				// in menus, only the menu-visible buttons react; everything else
+				// is left to SDL's touch -> mouse emulation
+				if ( btn >= 0 ) {
+					Touch_SendButtonCommand( &touchButtons[btn], qtrue );
+					Touch_SendButtonCommand( &touchButtons[btn], qfalse );
+					return qtrue;
+				}
+				return qfalse;
+			}
+
+			f = Touch_AllocFinger( e->tfinger.fingerId );
+			if ( !f ) {
+				return qtrue;
+			}
+
+			f->lastX = x;
+			f->lastY = y;
+
+			if ( btn >= 0 ) {
+				touchButton_t *b = &touchButtons[btn];
+
+				f->role = FR_BUTTON;
+				f->button = btn;
+				b->down = qtrue;
+				Touch_SendButtonCommand( b, qtrue );
+			} else if ( x < 0.45f && !stickActive ) {
+				f->role = FR_STICK;
+				stickActive = qtrue;
+				stickOriginX = x;
+				stickOriginY = y;
+				stickX = stickY = 0;
+			} else {
+				f->role = FR_LOOK;
+			}
+		}
+		return qtrue;
+
+	case SDL_FINGERMOTION:
+		f = Touch_FindFinger( e->tfinger.fingerId );
+		if ( !f ) {
+			return Touch_InGame();
+		}
+
+		x = e->tfinger.x;
+		y = e->tfinger.y;
+
+		switch ( f->role ) {
+		case FR_STICK:
+			Touch_UpdateStick( x, y );
+			break;
+		case FR_LOOK:
+			lookAccumX += ( x - f->lastX ) * Touch_Aspect();
+			lookAccumY += ( y - f->lastY );
+			break;
+		case FR_BUTTON:
+			if ( touchButtons[f->button].lookWhileHeld ) {
+				lookAccumX += ( x - f->lastX ) * Touch_Aspect();
+				lookAccumY += ( y - f->lastY );
+			}
+			break;
+		default:
+			break;
+		}
+
+		f->lastX = x;
+		f->lastY = y;
+		return qtrue;
+
+	case SDL_FINGERUP:
+		f = Touch_FindFinger( e->tfinger.fingerId );
+		if ( !f ) {
+			return Touch_InGame();
+		}
+
+		switch ( f->role ) {
+		case FR_STICK:
+			stickActive = qfalse;
+			stickX = stickY = 0;
+			break;
+		case FR_BUTTON:
+			{
+				touchButton_t *b = &touchButtons[f->button];
+
+				if ( b->down ) {
+					b->down = qfalse;
+					Touch_SendButtonCommand( b, qfalse );
+				}
+			}
+			break;
+		default:
+			break;
+		}
+
+		f->active = qfalse;
+		return qtrue;
+
+	default:
+		break;
+	}
+
+	return qfalse;
+}
+
+/*
+===============
+IN_Touch_Move
+
+Adds touch movement and look to the user command
+===============
+*/
+void IN_Touch_Move( usercmd_t *cmd ) {
+	float sens, sensY, cgameSens;
+	float yaw, pitch;
+
+	if ( !IN_Touch_Enabled() ) {
+		return;
+	}
+
+	if ( !Touch_InGame() ) {
+		if ( touchWasInGame ) {
+			Touch_ReleaseAll();
+			if ( clc.state != CA_ACTIVE ) {
+				Touch_ResetToggles();
+			}
+		}
+		touchWasInGame = qfalse;
+		lookAccumX = lookAccumY = 0;
+		return;
+	}
+	touchWasInGame = qtrue;
+
+	// movement
+	if ( stickActive ) {
+		float mag = sqrtf( stickX * stickX + stickY * stickY );
+
+		// small dead zone
+		if ( mag > 0.12f ) {
+			cmd->forwardmove = ClampChar( cmd->forwardmove + (int)( -stickY * 127.0f ) );
+			cmd->rightmove = ClampChar( cmd->rightmove + (int)( stickX * 127.0f ) );
+		}
+	}
+
+	// looking: one full screen height swipe == 120 degrees at sensitivity 1
+	sens = in_touchSens->value;
+	sensY = in_touchSensY->value;
+
+	cgameSens = 1.0f;
+	if ( cge && cge->CG_SensitivityScale() >= 0.0f ) {
+		// scoped weapons slow down the look speed
+		cgameSens = cge->CG_SensitivityScale();
+	}
+
+	yaw = lookAccumX * 120.0f * sens * cgameSens;
+	pitch = lookAccumY * 120.0f * sens * sensY * cgameSens;
+
+	if ( in_touchInvertY->integer ) {
+		pitch = -pitch;
+	}
+
+	if ( yaw != 0.0f || pitch != 0.0f ) {
+		cl.viewangles[YAW] -= yaw;
+		cl.viewangles[PITCH] += pitch;
+		cmd->buttons |= BUTTON_ANY;
+	}
+
+	lookAccumX = lookAccumY = 0;
+}
+
+/*
+===============
+Drawing
+===============
+*/
+static void Touch_DrawDisc( float cx, float cy, float r, const vec4_t color ) {
+	// approximate a filled circle with horizontal strips
+	const int strips = 14;
+	int       i;
+	float     stripH = ( 2.0f * r ) / strips;
+
+	re.SetColor( color );
+
+	for ( i = 0; i < strips; i++ ) {
+		float yMid = -r + ( i + 0.5f ) * stripH;
+		float half = sqrtf( r * r - yMid * yMid );
+
+		re.DrawBox( cx - half, cy - r + i * stripH, half * 2.0f, stripH );
+	}
+}
+
+/*
+===============
+Touch_IsRussian
+
+The Russian version of the game ships a localization file in Windows-1251
+(and fonts with Cyrillic letters), use Russian labels then
+===============
+*/
+static qboolean Touch_IsRussian( void ) {
+	if ( touchRussian < 0 ) {
+		void *buf = NULL;
+		int  len = FS_ReadFile( "global/localization.txt", &buf );
+		int  i, cyr = 0;
+
+		if ( buf && len > 0 ) {
+			const unsigned char *b = (const unsigned char *)buf;
+			for ( i = 0; i < len; i++ ) {
+				if ( b[i] >= 0xC0 ) {
+					cyr++;
+				}
+			}
+			FS_FreeFile( buf );
+		}
+
+		touchRussian = cyr > 200 ? 1 : 0;
+		if ( in_touchLang->string[0] ) {
+			touchRussian = !Q_stricmp( in_touchLang->string, "ru" );
+		}
+	}
+	return touchRussian == 1;
+}
+
+static void Touch_DrawLabel( const char *text, float cx, float cy, float pixelHeight, float maxWidth ) {
+	static const vec4_t shadow = { 0.0f, 0.0f, 0.0f, 0.85f };
+	vec2_t scale;
+	float  w, h, s, x, y, off;
+	int    len;
+
+	if ( !touchFont ) {
+		return;
+	}
+
+	h = re.GetFontHeight( touchFont );
+	if ( h <= 0 ) {
+		return;
+	}
+
+	// estimate the width (the renderer's width function can't handle
+	// characters above 127), and shrink long labels to fit the button
+	len = strlen( text );
+	w = len * pixelHeight * 0.62f;
+	if ( w > maxWidth && w > 0 ) {
+		pixelHeight *= maxWidth / w;
+		w = maxWidth;
+	}
+
+	s = pixelHeight / h;
+	scale[0] = scale[1] = s;
+
+	// the renderer multiplies the position by the scale as well
+	// (virtual screen coordinates), so pass it unscaled
+	x = ( cx - w * 0.5f ) / s;
+	y = ( cy - pixelHeight * 0.5f ) / s;
+	off = 2.0f / s;
+
+	re.SetColor( shadow );
+	re.DrawString( touchFont, text, x + off, y + off, -1, scale );
+
+	re.SetColor( colorWhite );
+	re.DrawString( touchFont, text, x, y, -1, scale );
+}
+
+void IN_Touch_Draw( void ) {
+	int   i;
+	int   vis;
+	float W, H;
+	float alpha;
+	vec4_t col;
+
+	if ( !IN_Touch_Enabled() ) {
+		return;
+	}
+
+	if ( clc.state != CA_ACTIVE && clc.state != CA_DISCONNECTED ) {
+		// loading screens etc.
+		return;
+	}
+
+	W = cls.glconfig.vidWidth;
+	H = cls.glconfig.vidHeight;
+	if ( W <= 0 || H <= 0 ) {
+		return;
+	}
+
+	if ( !touchFont ) {
+		touchFont = re.LoadFont( "verdana-14" );
+	}
+
+	vis = Touch_CurrentVisibility();
+	alpha = in_touchAlpha->value;
+
+	re.Set2DWindow( 0, 0, W, H, 0, W, H, 0, -1, 1 );
+
+	for ( i = 0; i < (int)NUM_TOUCH_BUTTONS; i++ ) {
+		const touchButton_t *b = &touchButtons[i];
+		float cx, cy, r;
+		qboolean lit;
+
+		if ( !( b->vis & vis ) ) {
+			continue;
+		}
+
+		cx = b->x * W;
+		cy = b->y * H;
+		r = b->r * in_touchScale->value * H;
+
+		lit = b->down || ( b->type == TB_TOGGLE && b->toggled )
+			|| ( b->type == TB_KEYBOARD && SDL_IsTextInputActive() );
+
+		col[0] = lit ? 1.0f : 0.6f;
+		col[1] = lit ? 0.8f : 0.6f;
+		col[2] = lit ? 0.3f : 0.6f;
+		col[3] = alpha * ( lit ? 1.6f : 1.0f );
+
+		Touch_DrawDisc( cx, cy, r, col );
+		Touch_DrawLabel( Touch_IsRussian() ? b->labelRu : b->label, cx, cy, r * 0.55f, r * 1.8f );
+	}
+
+	if ( vis == TV_GAME && stickActive ) {
+		float baseR = in_touchStickSize->value * in_touchScale->value * H;
+		float ox = stickOriginX * W;
+		float oy = stickOriginY * H;
+
+		col[0] = col[1] = col[2] = 0.6f;
+		col[3] = alpha * 0.8f;
+		Touch_DrawDisc( ox, oy, baseR, col );
+
+		col[0] = col[1] = col[2] = 0.9f;
+		col[3] = alpha * 1.8f;
+		Touch_DrawDisc( ox + stickX * baseR, oy + stickY * baseR, baseR * 0.45f, col );
+	}
+
+	re.SetColor( NULL );
+}
+
+/*
+===============
+IN_Touch_Init
+===============
+*/
+void IN_Touch_Init( void ) {
+#ifdef __ANDROID__
+	const char *defaultEnabled = "1";
+#else
+	const char *defaultEnabled = "0";
+#endif
+
+	in_touch = Cvar_Get( "in_touch", defaultEnabled, CVAR_ARCHIVE );
+	in_touchSens = Cvar_Get( "in_touchSens", "1.0", CVAR_ARCHIVE );
+	in_touchSensY = Cvar_Get( "in_touchSensY", "0.8", CVAR_ARCHIVE );
+	in_touchAlpha = Cvar_Get( "in_touchAlpha", "0.25", CVAR_ARCHIVE );
+	in_touchScale = Cvar_Get( "in_touchScale", "1.0", CVAR_ARCHIVE );
+	in_touchStickSize = Cvar_Get( "in_touchStickSize", "0.13", CVAR_ARCHIVE );
+	in_touchInvertY = Cvar_Get( "in_touchInvertY", "0", CVAR_ARCHIVE );
+	// "" = automatic, "ru" or "en"
+	in_touchLang = Cvar_Get( "in_touchLang", "", CVAR_ARCHIVE );
+
+	Com_Memset( fingers, 0, sizeof( fingers ) );
+	stickActive = qfalse;
+	touchFont = NULL;
+	touchRussian = -1;
+}
+
+/*
+===============
+IN_Touch_BlockMouse
+
+While playing, SDL's touch -> mouse emulation must be ignored,
+otherwise every touch would also shoot / turn the camera
+===============
+*/
+qboolean IN_Touch_BlockMouse( void ) {
+	return IN_Touch_Enabled() && Touch_InGame();
+}
